generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEADER
  MEMBER
}

enum RoomType {
  DIRECT
  GROUP
}

enum SubjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum MaterialStatus {
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

enum MaterialSourceType {
  OFFICIAL
  LECTURER
  PERSONAL
  COMMUNITY
  IMPORTED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            Role      @default(MEMBER)
  rank            String    @default("สมาชิก")
  uplineId        String?
  upline          User?     @relation("Line", fields: [uplineId], references: [id])
  downlines       User[]    @relation("Line")
  groupId         String?
  group           Group?    @relation(fields: [groupId], references: [id])
  themeColor      String    @default("#2563eb")
  avatarUrl       String?
  sales           Sale[]
  messages        Message[]
  customers       Customer[]
  goals           Goal[]
  academicYears   AcademicYear[]
  semesters       Semester[]
  subjects        Subject[]
  materials       Material[]
  quizzes         Quiz[]
  attempts        Attempt[]
  progress        LearningProgress[]
  studySessions   StudySession[]
}

model Group {
  id      String  @id @default(cuid())
  name    String
  members User[]
  rooms   Room[]
}

model Product {
  id       String     @id @default(cuid())
  name     String
  price    Decimal    @db.Decimal(10, 2)
  pv       Decimal    @db.Decimal(10, 2)
  note     String?
  imageUrl String?
  items    SaleItem[]
}

model Sale {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  date        DateTime   @default(now())
  totalAmount Decimal    @db.Decimal(12, 2)
  totalPV     Decimal    @db.Decimal(12, 2)
  items       SaleItem[]

  @@index([userId, date])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Decimal @db.Decimal(10, 2)
  unitPV    Decimal @db.Decimal(10, 2)
}

model Room {
  id       String    @id @default(cuid())
  type     RoomType
  groupId  String?
  group    Group?    @relation(fields: [groupId], references: [id])
  members  String[]
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

model Meeting {
  id       String   @id @default(cuid())
  title    String
  startsAt DateTime
  hostId   String
  groupId  String?
}

model Contest {
  id             String   @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  groupId        String?
  bigUplineTopN  Int      @default(3)
  bigUplineBonus Decimal  @default(0) @db.Decimal(10, 2)
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  note      String?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
}

model News {
  id        String   @id @default(cuid())
  title     String
  body      String
  imageUrl  String?
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  createdAt   DateTime @default(now())
}

model Goal {
  id        String   @id @default(cuid())
  title     String
  target    Decimal  @db.Decimal(12, 2)
  current   Decimal  @default(0) @db.Decimal(12, 2)
  period    String   @default("monthly")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  type      String   @default("info")
  read      Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
}

model AcademicYear {
  id        String     @id @default(cuid())
  name      String
  order     Int        @default(0)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesters Semester[]

  @@index([userId, order])
}

model Semester {
  id             String       @id @default(cuid())
  name           String
  order          Int          @default(0)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subjects       Subject[]

  @@index([userId, academicYearId])
}

model Subject {
  id          String        @id @default(cuid())
  code        String?
  name        String
  description String?
  credits     Int?
  instructor  String?
  color       String        @default("#2563eb")
  status      SubjectStatus @default(NOT_STARTED)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterId  String
  semester    Semester      @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  materials   Material[]
  quizzes     Quiz[]
  progress    LearningProgress[]

  @@index([userId, semesterId])
}

model Material {
  id           String              @id @default(cuid())
  title        String
  fileName     String?
  mimeType     String?
  sourceType   MaterialSourceType  @default(IMPORTED)
  status       MaterialStatus      @default(PROCESSING)
  textContent  String              @db.Text
  pageCount    Int?
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chunks       MaterialChunk[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId, subjectId, createdAt])
}

model MaterialChunk {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  chunkIndex Int
  pageNumber Int?
  embedding  Json?
  createdAt  DateTime @default(now())

  @@unique([materialId, chunkIndex])
  @@index([materialId])
}

model Quiz {
  id         String     @id @default(cuid())
  title      String
  subjectId  String
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions  Question[]
  attempts   Attempt[]
  createdAt  DateTime   @default(now())

  @@index([userId, subjectId, createdAt])
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        QuestionType @default(MULTIPLE_CHOICE)
  prompt      String       @db.Text
  options     Json?
  answer      String       @db.Text
  explanation String?      @db.Text
  source      Json?
  order       Int
}

model Attempt {
  id          String    @id @default(cuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Float
  answers     Json
  mistakes    Json?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model LearningProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  mastery    Float    @default(0)
  studyMins  Int      @default(0)
  lastActive DateTime @default(now())
  evidence   Json?

  @@unique([userId, subjectId])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  startedAt DateTime @default(now())
  endedAt   DateTime?
  minutes   Int       @default(0)
  goal      String?

  @@index([userId, startedAt])
}
