generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEADER
  MEMBER
}

enum RoomType {
  DIRECT
  GROUP
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(MEMBER)
  uplineId     String?
  upline       User?     @relation("Line", fields: [uplineId], references: [id])
  downlines    User[]    @relation("Line")
  groupId      String?
  group        Group?    @relation(fields: [groupId], references: [id])
  themeColor   String    @default("#2563eb")
  avatarUrl    String?
  sales        Sale[]
  messages     Message[]
}

model Group {
  id      String  @id @default(cuid())
  name    String
  members User[]
  rooms   Room[]
}

model Product {
  id       String     @id @default(cuid())
  name     String
  price    Decimal    @db.Decimal(10, 2)
  pv       Decimal    @db.Decimal(10, 2)
  note     String?
  imageUrl String?
  items    SaleItem[]
}

model Sale {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  date        DateTime   @default(now())
  totalAmount Decimal    @db.Decimal(12, 2)
  totalPV     Decimal    @db.Decimal(12, 2)
  items       SaleItem[]

  @@index([userId, date])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Decimal @db.Decimal(10, 2)
  unitPV    Decimal @db.Decimal(10, 2)
}

model Room {
  id       String    @id @default(cuid())
  type     RoomType
  groupId  String?
  group    Group?    @relation(fields: [groupId], references: [id])
  members  String[]
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

model Meeting {
  id       String   @id @default(cuid())
  title    String
  startsAt DateTime
  hostId   String
  groupId  String?
}

model Contest {
  id             String   @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  groupId        String?
  bigUplineTopN  Int      @default(3)
  bigUplineBonus Decimal  @default(0) @db.Decimal(10, 2)
}