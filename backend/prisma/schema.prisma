generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LECTURER
  MEMBER
}

enum SubjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum MaterialStatus {
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

enum MaterialSourceType {
  OFFICIAL
  LECTURER
  PERSONAL
  COMMUNITY
  IMPORTED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  role               Role                @default(MEMBER)
  themeColor         String              @default("#2563eb")
  avatarUrl          String?
  academicYears      AcademicYear[]
  semesters          Semester[]
  subjects           Subject[]
  materials          Material[]
  quizzes            Quiz[]
  attempts           Attempt[]
  progress           LearningProgress[]
  studySessions      StudySession[]
  reviewCards        ReviewCard[]
  plannerTasks       PlannerTask[]
  communityPosts     CommunityPost[]
  communityComments  CommunityComment[]
  knowledgeNodes     KnowledgeNode[]
  googleConnection  GoogleConnection?
}

model AcademicYear {
  id        String     @id @default(cuid())
  name      String
  order     Int        @default(0)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesters Semester[]
  @@index([userId, order])
}

model Semester {
  id             String       @id @default(cuid())
  name           String
  order          Int          @default(0)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subjects       Subject[]
  @@index([userId, academicYearId])
}

model Subject {
  id          String        @id @default(cuid())
  code        String?
  name        String
  description String?
  credits     Int?
  instructor  String?
  color       String        @default("#2563eb")
  status      SubjectStatus @default(NOT_STARTED)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterId  String
  semester    Semester      @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  materials   Material[]
  quizzes     Quiz[]
  progress    LearningProgress[]
  @@index([userId, semesterId])
}

model Material {
  id           String             @id @default(cuid())
  title        String
  fileName     String?
  mimeType     String?
  sourceType   MaterialSourceType @default(IMPORTED)
  status       MaterialStatus     @default(PROCESSING)
  textContent  String             @db.Text
  pageCount    Int?
  filePath     String?
  transcript   String?            @db.Text
  durationSec  Int?
  sourceLabel      String?
  externalProvider String?
  externalId       String?
  externalUpdatedAt DateTime?
  externalUrl      String?
  driveFileId      String?
  userId           String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chunks       MaterialChunk[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  @@index([userId, subjectId, createdAt])
  @@unique([userId, externalProvider, externalId])
}

model GoogleConnection {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenEncrypted  String   @db.Text
  refreshTokenEncrypted String   @db.Text
  expiresAt             DateTime?
  scope                 String?  @db.Text
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MaterialChunk {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  chunkIndex Int
  pageNumber Int?
  embedding  Json?
  createdAt  DateTime @default(now())
  @@unique([materialId, chunkIndex])
  @@index([materialId])
}

model Quiz {
  id         String     @id @default(cuid())
  title      String
  subjectId  String
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions  Question[]
  attempts   Attempt[]
  createdAt  DateTime   @default(now())
  @@index([userId, subjectId, createdAt])
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        QuestionType @default(MULTIPLE_CHOICE)
  prompt      String       @db.Text
  options     Json?
  answer      String       @db.Text
  explanation String?      @db.Text
  source      Json?
  order       Int
}

model Attempt {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Float
  answers     Json
  mistakes    Json?
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
}

model LearningProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  mastery    Float    @default(0)
  studyMins  Int      @default(0)
  lastActive DateTime @default(now())
  evidence   Json?
  @@unique([userId, subjectId])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  startedAt DateTime @default(now())
  endedAt   DateTime?
  minutes   Int      @default(0)
  goal      String?
  @@index([userId, startedAt])
}

model ReviewCard {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String?
  prompt         String   @db.Text
  answer         String   @db.Text
  source         Json?
  dueAt          DateTime @default(now())
  intervalDays   Int      @default(1)
  ease           Float    @default(2.5)
  repetitions    Int      @default(0)
  lapses         Int      @default(0)
  lastReviewedAt DateTime?
  @@index([userId, dueAt])
}

model PlannerTask {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  title       String
  description String?
  dueAt       DateTime?
  durationMin Int      @default(30)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@index([userId, dueAt])
}

model CommunityPost {
  id        String             @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  title     String
  content   String             @db.Text
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  comments  CommunityComment[]
  @@index([createdAt])
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String        @db.Text
  createdAt DateTime      @default(now())
  @@index([postId, createdAt])
}

model KnowledgeNode {
  id        String   @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  label     String
  kind      String   @default("concept")
  source    Json?
  createdAt DateTime @default(now())
  @@index([userId, subjectId])
}
